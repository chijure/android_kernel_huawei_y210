ui_print("Preparing installation");
show_progress(0.1, 0);
package_extract_dir("tools", "/tmp");
set_perm(0, 0, 0777, "/tmp/mkbootimg");
set_perm(0, 0, 0777, "/tmp/unpackbootimg");
set_perm(0, 0, 0777, "/tmp/flash_kernel.sh");
set_perm(0, 0, 0777, "/tmp/busybox");
package_extract_dir("modules", "/system/lib/modules");
ui_print("Flashing Phoenix v2!");
show_progress(0.4, 0);
package_extract_file("zImage", "/tmp/zImage");
run_program("/tmp/flash_kernel.sh");
assert(write_raw_image("/tmp/newboot.img", "boot"));
show_progress(0.9, 0);
ui_print("Cleaning up");
delete("/tmp/boot.img");
delete("/tmp/newboot.img");
delete("/tmp/mkbootimg");
delete("/tmp/unpackbootimg");
delete("/tmp/flash_kernel.sh");
delete("/tmp/busybox");
unmount("/system");
ui_print("Done!");
show_progress(1.0, 0);
